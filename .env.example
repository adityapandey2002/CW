# Copy to .env.local and fill in. Never commit .env* files.

# Production site URL used by metadata, sitemap, robots, manifest and OG image.
# Defaults to https://consultancywala.com when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend API key for contact-form email delivery. Required for emails to send;
# without it the form still validates and returns a generic error.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must use a verified domain in production; falls back to the
# Resend sandbox sender (Consultancy Wala <onboarding@resend.dev>) when unset.
RESEND_FROM_EMAIL=Consultancy Wala <hello@consultancywala.com>